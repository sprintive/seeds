{
  "name": "sprintive/seeds",
  "description": "Kickoff distro for SME's, Curated by Sprintive",
  "type": "drupal-profile",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "drush/drush": "^12.4.3",
    "drupal/coder": "*",
    "composer/composer": "^2",
    "cweagans/composer-patches": "1.7.3",
    "drupal/core-composer-scaffold": "^10.0",
    "drupal/core": "11.1.2",
    "drupal/seeds_editor": "^1.1",
    "drupal/seeds_media": "^1.0",
    "drupal/seeds_pollination": "^1.0",
    "drupal/seeds_development": "^1.0",
    "drupal/seeds_security": "^1.0",
    "drupal/seeds_seo": "^2.0",
    "drupal/seeds_performance": "^1.0",
    "drupal/seeds_layouts": "^2.0",
    "drupal/seeds_toolbar": "^2.0",
    "drupal/seeds_ui": "1.0.x-dev",
    "drupal/seeds_page": "^1.0",
    "drupal/seeds_administration": "^1.0"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "conflict": {
    "drupal/drupal": "*"
  },
  "extra": {
    "branch-alias": {
      "13.0.x-dev": "12.0.x-dev"
    },
    "installer-paths": {
      "public_html/core": [
        "type:drupal-core"
      ],
      "public_html/libraries/{$name}": [
        "type:drupal-library",
        "type:bower-asset",
        "type:npm-asset"
      ],
      "public_html/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "public_html/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "public_html/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/contrib/{$name}": [
        "type:drupal-drush"
      ]
    },
    "enable-patching": true,
    "composer-exit-on-patch-failure": false,
    "installer-types": [
      "bower-asset",
      "npm-asset"
    ],
    "patchLevel": {
      "drupal/core": "-p2"
    },
    "patches": {
      "drupal/advagg": {
        "issues 3375725  Deprecated function: Creation of dynamic property": "https://www.drupal.org/files/issues/2023-07-28/3375725-5.patch"
      },
      "drupal/ace_editor": {
        "#ISSUE 2941227 Fix Missing install/schema-1": "https://www.drupal.org/files/issues/2022-01-26/ace_editor-2941227-8.patch",
        "#ISSUE 2941227 Fix Missing install/schema-2": "https://www.drupal.org/files/issues/2024-06-22/ace_editor-3455758-8--interdiff.patch"
      },
      "drupal/paragraphs": {
        "issue #3090200 :Paragraph access check using incorrect revision of its parent": "https://www.drupal.org/files/issues/2022-10-26/3084934-13_combine_3090200-22.patch"
      }
    }
  },
  "config": {
    "bin-dir": "bin/"
  },
  "autoload": {
    "psr-4": {
      "Drush\\Seeds\\": "modules/custom/seeds_pollination/Drush"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "DrupalComposer\\DrupalScaffold\\Plugin::scaffold"
    ],
    "post-update-cmd": [
      "DrupalComposer\\DrupalScaffold\\Plugin::scaffold"
    ]
  },
  "authors": [
    {
      "name": "Sprintive",
      "homepage": "http://sprintive.com",
      "role": "Supporting Organization"
    },
    {
      "name": "Mohammad Abdul-Qader",
      "homepage": "https://www.drupal.org/u/mabdulqader",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "http://drupal.org/project/issues/seeds",
    "source": "http://cgit.drupalcode.org/seeds",
    "email": "info@sprintive.com"
  }
}
